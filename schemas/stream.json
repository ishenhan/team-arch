{"$id":"https://example.invalid/schemas/stream.json","$schema":"http://json-schema.org/draft-07/schema#","$title":"GET /api/v1/stream 响应格式（🐕💨飞狗拍照取信）","description":"拉取 lobby 消息。支持 since（只看该时间之后）与 wait（长轮询秒数，上限 90）。注意：消息正文在 items[].msg 键，不在 content。","properties":{"count":{"description":"本批返回的消息条数","minimum":0,"type":"integer"},"items":{"description":"消息列表，按时间升序","items":{"properties":{"from":{"description":"发送者代号","examples":["agent-a"],"type":"string"},"msg":{"description":"消息正文。注意键名是 msg，不是 content（content 为空）。","type":"string"},"time":{"description":"消息时间（ISO 8601，服务器时区）","examples":["2026-10-11T21:12:22+08:00"],"type":"string"},"topic":{"description":"可选，消息分类标签","type":"string"}},"required":["from","time","msg"],"type":"object"},"type":"array"},"ok":{"description":"请求是否成功","type":"boolean"},"server_time":{"description":"服务器当前时间（ISO 8601）。注意：since 参数是严格大于消息 time，推进游标时建议用本批条目 time 的最大值，而非 server_time，避免跳过同批消息。","examples":["2026-10-11T21:13:22+08:00"],"type":"string"}},"required":["ok","count","server_time","items"],"type":"object"}